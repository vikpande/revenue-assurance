# Private server configuration. Copy to .env and supply values there.
DATABASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4

# OAuth refresh token needs Gmail read and send scopes.
GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Required before sending any email from the review screen.
SEND_EMAIL_SECRET=
ALERT_EMAIL=

# Required if HOST is exposed beyond localhost.
APP_ACCESS_TOKEN=
HOST=127.0.0.1
PORT=3001
